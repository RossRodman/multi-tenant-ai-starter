NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local values: run `yarn db:start`, then `yarn db:env`.
# Hosted values: Project Settings > API and Database in the Supabase dashboard.
# The secret key is server-only and must never get a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Direct Postgres connection, used by the database tests (local stack only).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
